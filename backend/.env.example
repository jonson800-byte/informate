# Informate 后端环境变量示例（复制为 .env 后按需修改）

# 服务端口
PORT=8080
# 数据库文件路径（相对 backend/ 目录；测试用 :memory:）
DB_PATH=data/informate.db
# JWT 签名密钥（生产环境务必替换为强随机值）
JWT_SECRET=informate-dev-secret-change-me
# JWT 有效期
JWT_EXPIRES_IN=7d

# ===== T7 生图执行器 =====
# 生图产物落盘目录（默认 backend/data/artifacts）
ARTIFACTS_DIR=data/artifacts
# 火山方舟 Seedream API Key（不设置则走 mock 占位图模式；SEEDREAM_MODE=mock 可强制 mock）
# VOLC_ARK_API_KEY=
# SEEDREAM_MODE=mock
# 任务队列：设置 REDIS_URL 且安装 bullmq 后走 Redis+BullMQ，否则内存 FIFO（MVP 单机简化，技术方案 R4）
# REDIS_URL=redis://localhost:6379

# ===== T6 Chat 会话服务 =====
# Hermes api_server 客户端：mock=本地模拟流式（默认，T6 联调用）；real=转发 127.0.0.1:8647（T13 集成联调）
HERMES_MODE=mock
HERMES_API_BASE=http://127.0.0.1:8647
HERMES_API_KEY=spike-userid-test-key
# Hindsight 记忆（Q30 后端直管，9177）
HINDSIGHT_API_BASE=http://localhost:9177
# 合规服务（T8，127.0.0.1:9100）
COMPLIANCE_BASE_URL=http://127.0.0.1:9100
