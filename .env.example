# Informate production example. Copy to .env and replace every CHANGE_ME value.
NODE_ENV=production
JWT_SECRET=CHANGE_ME_AT_LEAST_48_RANDOM_BYTES
DB_PATH=/app/data/informate.db
ARTIFACTS_DIR=/app/data/artifacts
CORS_ORIGIN=https://informate.example.com

# Text model: deepseek (recommended) or hermes
CHAT_PROVIDER=deepseek
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_MODEL=deepseek-v4-flash
# HERMES_API_BASE=http://hermes:8647
# HERMES_API_KEY=CHANGE_ME

# Seedream / Volcengine Ark
SEEDREAM_MODE=real
VOLC_ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLC_ARK_API_KEY=CHANGE_ME
VOLC_ARK_SEEDREAM_MODEL=CHANGE_ME_ENDPOINT_OR_MODEL_ID
SEEDREAM_SIZE=2048x2048
IMAGE_QUEUE_CONCURRENCY=2

# Required services
REDIS_URL=redis://redis:6379/0
COMPLIANCE_BASE_URL=http://compliance:9100
HINDSIGHT_API_BASE=http://host.docker.internal:9177

# Production defaults to manual confirmation; never use mock in production.
RECHARGE_MODE=manual

# Only required for the first production start. Remove the password after bootstrap.
BOOTSTRAP_ADMIN_USERNAME=informate-admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
BOOTSTRAP_ADMIN_NAME=平台管理员
